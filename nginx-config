# =============================
# tbdices.com (Next.js, port 3000)
# =============================
server {
    listen 80;
    server_name tbdices.com www.tbdices.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 100M;

    # Optional: Redirect www → non-www
    if ($host = www.tbdices.com) {
        return 301 https://tbdices.com$request_uri;
    }
}

# =============================
# admin.tbdices.com (Prisma Studio, port 5000)
# =============================
server {
    listen 80;
    server_name admin.tbdices.com;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 50M;
}
